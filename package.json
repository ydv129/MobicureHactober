{
  "name": "mobicure",
  "version": "1.0.0",
  "description": "Enterprise-grade client-side cybersecurity suite, real-time network forensics, zero-knowledge encrypted vault, and tactical diagnostics.",
  "author": "Neeraj Yadav",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "concurrently \"cd services/apk-analyzer && python3 apk_analyzer_service.py\" \"cd services/image-metadata-scanner && python3 image_scanner_light.py\" \"next dev\" --names \"APK,IMG,WEB\" --prefix-colors \"cyan,magenta,yellow\"",
    "dev:web": "next dev",
    "dev:apk": "cd services/apk-analyzer && python3 apk_analyzer_service.py",
    "dev:image": "cd services/image-metadata-scanner && python3 image_scanner_light.py",
    "dev:all": "concurrently --names \"WEB,MCP,GEMMA\" --colors \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"next dev --port 3000\" \"pnpm --filter mobicure-mcp-server dev\" \"ollama serve\"",
    "lint": "next lint",
    "start": "next start --port 3000",
    "speedtest:start": "python scripts/speedtest_server.py",
    "speedtest:dev": "uvicorn scripts.speedtest_server:app --host 0.0.0.0 --port 8765 --reload",
    "scanner:start": "python3 scripts/image_metadata_scanner_service.py --start",
    "scanner:stop": "python3 scripts/image_metadata_scanner_service.py --stop",
    "scanner:restart": "python3 scripts/image_metadata_scanner_service.py --restart",
    "scanner:status": "python3 scripts/image_metadata_scanner_service.py --status",
    "python-bridge": "python3 scripts/python_bridge_server.py",
    "gemma": "bash scripts/gemma-proof.sh",
    "gemma:pull": "ollama pull gemma2:2b",
    "gemma:list": "ollama list",
    "gemma:test": "curl -s -X POST http://localhost:11434/api/generate -H 'Content-Type: application/json' -d '{\"model\":\"gemma2:2b\",\"prompt\":\"APK whatsapp-gb-mod.apk safe hai? Hinglish 1 line\",\"stream\":false}' | jq -r.response",
    "gemma:offline-proof": "echo '=== OFFLINE PROOF: Gemma runs on localhost, no cloud ===' && echo \"OLLAMA_URL: $(grep -r OLLAMA_URL lib/ || echo http://localhost:11434)\" && ollama list && curl -s http://localhost:11434/api/tags | jq.models[].name",
    "mcp:build": "pnpm --filter mobicure-mcp-server build",
    "mcp:dev": "pnpm --filter mobicure-mcp-server build && node mcp-server/dist/index.js",
    "mcp:list": "echo '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | node mcp-server/dist/index.js 2>&1 | grep -o '\"name\":\"[^\"]*\"'",
    "check:ready": "bash scripts/check-ready.sh",
    "kill": "sh ./kill.sh",
    "kill:all": "pkill -9 node || true; pkill -9 -f next || true; lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null || true; lsof -ti:11434 2>/dev/null | xargs kill -9 2>/dev/null || true; rm -rf .next node_modules/.cache; echo '💀💀 Full kill - All Node + Next + Ollama port killed'",
    "dev:clean": "pnpm run kill && pnpm run dev -- --port 3000",
    "restart": "pnpm run kill && sleep 2 && pnpm run dev -- --port 3000",
    "kill:hard": "pkill -9 node 2>/dev/null || true; lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null || true; rm -rf .next node_modules/.cache build.log dev.log 2>/dev/null || true; clear; echo '💀💀 HARD KILL + CLEAR ✅'; echo '🚀 Starting fresh...'; sleep 1; pnpm run dev -- --port 3000",
    "kill:dev": "pkill -9 -f 'next dev' 2>/dev/null; rm -rf .next; next dev --port 3000",
    "fresh": "pkill -9 -f 'next dev' 2>/dev/null; rm -rf .next; next dev --port 3000",
    "check": "bash scripts/check-ready.sh",
    "kd": "bash kill.sh || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@tanstack/react-query": "^5.104.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.6.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "form-data": "^4.0.5",
    "geist": "^1.3.1",
    "input-otp": "1.4.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.454.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-day-picker": "9.8.0",
    "react-dom": "^19",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "3.25.67",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "minimatch": "^10.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "concurrently": "^10.0.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "oxlint": "^1.88.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}