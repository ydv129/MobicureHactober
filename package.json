{
  "name": "mobicure-forensics",
  "version": "2.0.0-light",
  "private": true,
  "description": "MobiCure Forensics v2 Light - Hybrid Image + URL + APK Forensics Lab <400MB",
  "scripts": {
    "predev": "./kill.sh",
    "dev": "concurrently \"python src/lib/forensics/engine/main.py\" \"./node_modules/.bin/next dev --port 3000\" --names \"ENGINE,WEB\" --prefix-colors \"cyan,yellow\"",
    "dev:engine": "python src/lib/forensics/engine/main.py",
    "dev:web": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
